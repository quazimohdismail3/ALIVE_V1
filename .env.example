# Mission Alive — environment variables (V1)
# Copy to .env and fill. .env is gitignored — never commit it.

# Database
DATABASE_URL=sqlite:///./mission_alive.db

# Personal RMSSD baseline (Quazi defaults — override per user)
PERSONAL_RMSSD_MIN=52
PERSONAL_RMSSD_MAX=122
PERSONAL_RMSSD_MEAN=88

# WHOOP API (optional in V1)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/whoop/callback

# Spotify (optional in V1)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Gemini (NOT required in V1 — Strategy B is stubbed)
# GEMINI_API_KEY=
