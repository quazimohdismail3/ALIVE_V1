# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Postgres (Supabase connection pooler — use port 6543 for transaction mode)
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Sentry
SENTRY_DSN=https://xxx@o0.ingest.sentry.io/000
ENVIRONMENT=production
