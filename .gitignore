.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
vagus_env/
venv/
env/
.venv/

# Node / Vite
node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Claude Code local state
.claude/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

